":"索绯雅","fields":{"q":"我从小就在爸爸和朋友们的宴会上大吃大喝。要是我办那样的大派对，你要来吗？","r":"展开翅膀","en":"I grew up enjoying food at my dad's feasts with his friends. If I have a big party like that, want to come?","name":"索绯雅"},"entityIds":["character-game8-816448"],"sourceIds":["cn-bird"],"routes":[],"sourceFacts":{"q":{"value":"我从小就在爸爸和朋友们的宴会上大吃大喝。要是我办那样的大派对，你要来吗？","sources":[{"source_id":"cn-bird","pointer":"/data/chars/42/lines/2/q"}],"game_version":"unknown","updated_at":"2026-10-15"},"r":{"value":"展开翅膀","sources":[{"source_id":"cn-bird","pointer":"/data/chars/42/lines/2/r"}],"game_version":"unknown","updated_at":"2026-10-15"},"en":{"value":"I grew up enjoying food at my dad's feasts with his friends. If I have a big party like that, want to come?","sources":[{"source_id":"cn-bird","pointer":"/data/chars/42/lines/2/en"}],"game_version":"unknown","updated_at":"2026-10-15"},"name":{"value":"索绯雅","sources":[{"source_id":"cn-bird","pointer":"/data/chars/42/name"}],"game_version":"unknown","updated_at":"2026-10-15"}},"unresolvedNames":[]},{"id":"relation-bird-76a1f2a93152","kind":"bird","title":"索绯雅","fields":{"q":"我胃口超好。神殿给的薪水根本不够我吃饭。很惨吧？","r":"轻声歌唱","en":"I have a VERY healthy appetite. The pay I get from the temple can't cover my meals. Tragic, right?","name":"索绯雅"},"entityIds":["character-game8-816448"],"sourceIds":["cn-bird"],"routes":[],"sourceFacts":{"q":{"value":"我胃口超好。神殿给的薪水根本不够我吃饭。很惨吧？","sources":[{"source_id":"cn-bird","pointer":"/data/chars/42/lines/3/q"}],"game_version":"unknown","updated_at":"2026-10-15"},"r":{"value":"轻声歌唱","sources":[{"source_id":"cn-bird","pointer":"/data/chars/42/lines/3/r"}],"game_version":"unknown","updated_at":"2026-10-15"},"en":{"value":"I have a VERY healthy appetite. The pay I get from the temple can't cover my meals. Tragic, right?","sources":[{"source_id":"cn-bird","pointer":"/data/chars/42/lines/3/en"}],"game_version":"unknown","updated_at":"2026-10-15"},"name":{"value":"索绯雅","sources":[{"source_id":"cn-bird","pointer":"/data/chars/42/name"}],"game_